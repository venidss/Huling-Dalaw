; Engine configuration file for DAET: ANG PAMANA
; A Filipino first-person psychological horror game
; Godot 4.x project

config_version=5

[application]

config/name="Daet: Ang Pamana"
config/description="A first-person Filipino psychological horror game set in an ancestral house in Daet, Camarines Norte."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.02, 0.04, 1)

[autoload]

Settings="*res://scripts/autoload/settings.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Inventory="*res://scripts/autoload/inventory.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
HorrorManager="*res://scripts/autoload/horror_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
SceneLoader="*res://scripts/autoload/scene_loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/vsync/vsync_mode=1

